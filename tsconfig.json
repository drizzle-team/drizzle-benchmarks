{
  // src/ and prisma7/ run as native TypeScript on Node (>= 22.18, type stripping) and on Bun.
  // bench/, bunload/, viewer/ and prisma8/ have their own tsconfig.json.
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    // only syntax Node's type stripping can run (no enums, namespaces, parameter properties)
    "erasableSyntaxOnly": true,
    // type-only imports must say `import type`, or Node fails at runtime on the missing export
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun"]
  },
  "include": ["src", "prisma7", "*.ts"],
  "exclude": ["node_modules", "prisma7/generated", "dist"]
}
